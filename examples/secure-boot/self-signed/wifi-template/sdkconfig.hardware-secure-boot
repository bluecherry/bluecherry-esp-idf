# Opt-in: hardware Secure Boot V2, flash encryption and NVS encryption.
#
# PERMANENT. The first boot burns eFuses that can never be cleared: from then on the chip only boots
# firmware signed with secure_boot_signing_key.pem, and JTAG is disabled. This file is only used
# when named explicitly, see "Hardware secure boot" in README.md.

# Replaces the signed-apps-only mode of sdkconfig.defaults.
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y

# A bootloader with secure boot and flash encryption does not fit below 0x8000.
CONFIG_PARTITION_TABLE_OFFSET=0xD000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-hardware-secure-boot.csv"

# Development mode, with encrypted flashing over UART left enabled, so the device can still be
# reflashed by cable with idf.py encrypted-app-flash.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=y

# NVS holds the credentials ZTP issues. Its keys live in the flash-encrypted nvs_keys partition.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
