menu "BlueCherry OTA signing"

    config BLUECHERRY_OTA_SIGNING_KEY
        string "Path to ED25519 Private Key (YubiKey/SSH)"
        default "~/.ssh/id_ed25519_OTA_update"
        help
            The path to the private key file used for signing the OTA payload.
            Supports SSH resident keys backed by hardware tokens like YubiKeys.

endmenu
